      "css": ".ds-fold{border-top:1px solid #1e2228;border-bottom:1px solid #1e2228}.ds-fold summary{list-style:none;display:flex;align-items:baseline;gap:14px;padding:18px 2px;font:700 16px Outfit,sans-serif;color:#eef1f5;cursor:pointer}.ds-fold summary::-webkit-details-marker{display:none}.ds-fold summary::before{content:'';align-self:center;width:7px;height:7px;border-right:2px solid #3fd9a4;border-bottom:2px solid #3fd9a4;transform:rotate(-45deg)}.ds-fold[open] summary::before{transform:rotate(45deg)}.ds-fold small{font-size:14px;font-weight:400;color:#818b98}"
