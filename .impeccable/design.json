      "name": "Broadcast Bug",
      "kind": "custom",
      "refersTo": "bug-name",
      "description": "Flush square blocks: LIVE, jade mark, name, jade guild slot.",
      "html": "<div class=\"ds-bug\"><span class=\"l\"><i></i>Live</span><span class=\"m\"></span><span class=\"n\">bmiest</span><span class=\"s\">Kelderklasse</span></div>",
      "css": ".ds-bug{display:flex;height:40px;font:800 14px/1 Outfit,system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase}.ds-bug>*{display:flex;align-items:center;gap:9px}.ds-bug .l{padding:0 18px;background:#e5484d;color:#eef1f5;font-size:13px;letter-spacing:.14em}.ds-bug .l i{width:8px;height:8px;border-radius:999px;box-shadow:0 0 0 2px #eef1f5}.ds-bug .m{width:40px;background:#3fd9a4;margin-right:5px}.ds-bug .n{padding:0 20px 0 0;background:#0a0b0d;color:#eef1f5}.ds-bug .s{padding:0 18px;background:#3fd9a4;color:#0a0b0d;letter-spacing:.06em}"
    },
    {
      "name": "Ribbon",
      "kind": "custom",
      "refersTo": "ribbon",
      "description": "Slanted 1px outline, ink-800 body, key block left.",
      "html": "<div class=\"ds-rib\"><div class=\"in\"><span class=\"k\">ilvl</span><span class=\"v\">327.0</span></div></div>",
      "css": ".ds-rib{width:340px;height:44px;padding:1px;background:#2a2f37;clip-path:polygon(0 0,100% 0,calc(100% - 11px) 100%,0 100%)}.ds-rib .in{height:100%;display:flex;align-items:center;background:#131519;clip-path:polygon(0 0,100% 0,calc(100% - 10px) 100%,0 100%)}.ds-rib .k{width:76px;height:100%;display:grid;place-items:center;background:#1e2228;color:#a8b1bc;font:800 10px Outfit,sans-serif;letter-spacing:.14em;text-transform:uppercase;clip-path:polygon(0 0,100% 0,calc(100% - 10px) 100%,0 100%)}.ds-rib .v{padding-left:13px;color:#eef1f5;font:700 18px 'JetBrains Mono',monospace}"
    },
    {
      "name": "Character Pick",
      "kind": "custom",
      "refersTo": "pick-active",
      "description": "60px ribbon with avatar; chosen = jade outline.",
      "html": "<button class=\"ds-pick\"><span class=\"in\"><span class=\"a\"></span><span class=\"t\"><b>Shiftheal</b><small>Holy Priest · Ragnaros</small></span></span></button>",
      "css": ".ds-pick{width:300px;height:60px;border:0;padding:1px;background:#3fd9a4;clip-path:polygon(0 0,100% 0,calc(100% - 11px) 100%,0 100%);font-family:Outfit,sans-serif;text-align:left}.ds-pick .in{height:100%;display:flex;align-items:center;background:#171a1f;clip-path:polygon(0 0,100% 0,calc(100% - 10px) 100%,0 100%)}.ds-pick .a{width:58px;height:100%;background:#0e1014}.ds-pick .t{display:grid;gap:2px;padding-left:14px}.ds-pick b{font-size:18px;font-weight:700;color:#eef1f5}.ds-pick small{font-size:12px;color:#3fd9a4}"
    },
