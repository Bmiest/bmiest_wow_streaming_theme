      "css": ".ds-btn{display:inline-flex;align-items:center;height:48px;padding:0 30px 0 20px;background:#3fd9a4;color:#0a0b0d;font:800 15px Outfit,sans-serif;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;clip-path:polygon(0 0,100% 0,calc(100% - 11px) 100%,0 100%);transition:background 160ms cubic-bezier(.22,.61,.36,1)}.ds-btn:hover{background:#eef1f5}"
