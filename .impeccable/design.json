      "css": ".ds-ty{display:flex;height:28px;font:800 11px Outfit,sans-serif;letter-spacing:.14em;text-transform:uppercase}.ds-ty>*{display:flex;align-items:center;padding:0 11px}.ds-ty .k{background:#3fd9a4;color:#0a0b0d}.ds-ty .n{background:#131519;color:#eef1f5}.ds-ty .f{color:#818b98;font:400 12px 'JetBrains Mono',monospace;letter-spacing:0;text-transform:none}"
